{
  "name": "plantline",
  "version": "0.1.0",
  "private": true,
  "description": "Single-line diagrams and DWG/DXF plant layouts in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "cad": "node scripts/build-cad.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src e2e scripts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "1.61.0",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
